/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Content-Security-Policy is deliberately NOT set here. Cloudflare combines
# every matching rule rather than letting the most specific one win, so a CSP
# on /* plus a CSP on /about/ ships two headers and the browser enforces their
# intersection — which blocks the inline scripts the per-route hashes exist to
# allow. scripts/csp.mjs appends one CSP rule per route below this, so exactly
# one ever matches. Run `npm run build`, never edit out/_headers by hand.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Staged interactive datasets, fetched on demand by the demos. Rebuilt on every
# deploy, so a short shared cache with revalidation rather than immutable.
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
