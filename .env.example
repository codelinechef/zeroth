
# Database — always the restricted role, never postgres
DATABASE_URL=postgresql://zeroth_app:local_dev_only@localhost:5433/zeroth

# Model serving
VLLM_BASE_URL=http://127.0.0.1:8001/v1
OLLAMA_HOST=http://127.0.0.1:11435
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# LLM providers for golden-set drafting and judging
GROQ_API_KEY=
GEMINI_API_KEY=

HF_TOKEN=

# SEC EDGAR requires an identifying contact in the User-Agent
# SEC EDGAR rejects requests without an identifying contact. Put YOUR name
# and email here — this file is committed, so it must not carry a real one.
EDGAR_USER_AGENT=Your Name your.email@example.com
